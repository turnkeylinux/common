-# find_value(name, &config)
+# Expand server includes in their actual order and retain each option's owner.
+sub read_sshd_includes
+{
+my ($file, $rv, $conditional, $depth) = @_;
+$depth < 16 || &error("SSH configuration includes are nested too deeply");
+require File::Glob;
+require Text::ParseWords;
+open(my $fh, '<', $file) || &error("Cannot read SSH configuration $file: $!");
+my $line = 0;
+while (my $text = <$fh>) {
+    $text =~ s/^\s+|\s+$//g;
+    if (!$text || $text =~ /^#/) { $line++; next; }
+    my ($name, @values) = Text::ParseWords::shellwords($text);
+    if (lc($name) eq 'include') {
+        foreach my $pattern (@values) {
+            last if $pattern =~ /^#/;
+            $pattern = "/etc/ssh/$pattern" if $pattern !~ m{^/};
+            foreach my $included (sort { $a cmp $b } File::Glob::bsd_glob($pattern)) {
+                next if !-f $included;
+                &read_sshd_includes($included, $rv, $conditional, $depth+1);
+                }
+            }
+        }
+    else {
+        $conditional = 1 if lc($name) eq 'match';
+        push(@$rv, { 'name' => $name, 'values' => \@values,
+            'file' => $file, 'line' => $line, 'conditional' => $conditional });
+        }
+    $line++;
+    }
+close($fh);
+}
